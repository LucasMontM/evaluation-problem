@host = http://localhost:5119

### Create sale
# @name createSale
POST {{host}}/api/sales
Content-Type: application/json

{
  "saleNumber": "S-0001",
  "saleDate": "2026-09-30T10:00:00Z",
  "customerId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
  "customerName": "John Doe",
  "branchId": "9b2f1c3e-1a2b-4c5d-8e9f-0a1b2c3d4e5f",
  "branchName": "Belo Horizonte - Savassi",
  "items": [
    { "productId": "11111111-1111-1111-1111-111111111111", "productName": "Brahma 350ml", "quantity": 3,  "unitPrice": 4.50 },
    { "productId": "22222222-2222-2222-2222-222222222222", "productName": "Skol 350ml",   "quantity": 5,  "unitPrice": 4.00 },
    { "productId": "33333333-3333-3333-3333-333333333333", "productName": "Stella 330ml", "quantity": 12, "unitPrice": 6.90 }
  ]
}

@saleId = {{createSale.response.body.data.id}}
@itemId = {{createSale.response.body.data.items[0].id}}

### Get sale
GET {{host}}/api/sales/{{saleId}}

### List sales
GET {{host}}/api/sales?_page=1&_size=10&_order=saleDate desc, saleNumber&customerName=John*&isCancelled=false

### Update sale
PUT {{host}}/api/sales/{{saleId}}
Content-Type: application/json

{
  "saleDate": "2026-09-30T10:00:00Z",
  "customerId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
  "customerName": "John Doe",
  "branchId": "9b2f1c3e-1a2b-4c5d-8e9f-0a1b2c3d4e5f",
  "branchName": "Belo Horizonte - Savassi",
  "items": [
    { "productId": "11111111-1111-1111-1111-111111111111", "productName": "Brahma 350ml", "quantity": 10, "unitPrice": 4.50 }
  ]
}

### Cancel item
PATCH {{host}}/api/sales/{{saleId}}/items/{{itemId}}/cancel

### Cancel sale
PATCH {{host}}/api/sales/{{saleId}}/cancel

### Delete sale
DELETE {{host}}/api/sales/{{saleId}}
